<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecuperacionJoseDiazPascual.MVVM.Views.PrincipalView"
             Title="PrincipalView">
    <ContentPage.BindingContext>
        <vm:PrincipalViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <CollectionView IsVisible="{Binding Tareas.Count}" ItemsSource="{Binding Tareas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10">
                        <StackLayout Orientation="Horizontal">
                            <Label Source="{Binding Titulo}"/>
                            <Label Source="{Binding Descripcion}"/>
                            <Label Source="{Binding Estado}"/>
                            <Label Source="{Binding Prioridad}"/>
                            <StackLayout>
                                <!-- Aqui va lo de las etiquetas -->
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>