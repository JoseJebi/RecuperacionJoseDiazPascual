<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecuperacionJoseDiazPascual.MVVM.Views.GestionEtiquetasView">
    
    <ScrollView>
        <VerticalStackLayout>
            <BoxView HeightRequest="20" Color="Transparent" />
            <!-- Entry para nombre de etiqueta nueva o editada -->
            <Entry x:Name="NombreEtiqueta"
                   Placeholder="Crea una etiqueta"
                   Text="{Binding NombreEtiqueta}"
                   FontSize="16" />

            <!-- Botón para guardar (agregar o actualizar) -->
            <Button Text="Crear etiqueta"
                    Command="{Binding GuardarEtiquetaCommand}"/>

            <BoxView HeightRequest="35" Color="Transparent" />

            <Label Text="Etiquetas Disponibles"
                   FontSize="28"
                   FontAttributes="Bold"
                   Margin="0,20,0,10" />

            <!-- Lista de etiquetas con botones para editar y eliminar -->
            <CollectionView ItemsSource="{Binding Etiqueta}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" CornerRadius="10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label Text="{Binding Titulo}" 
                                       VerticalOptions="Center" 
                                       FontSize="16"
                                       Grid.Column="0"
                                       HorizontalOptions="Start" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                    <Button Text="Editar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarEtiquetaCommand}"
                                            CommandParameter="{Binding .}" />
                                    
                                    <Button Text="Eliminar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarEtiquetaCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botón para volver -->
            <Button Text="←"
                    Command="{Binding VolverAgregarTarea}"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    TextColor="White"
                    CornerRadius="30"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>